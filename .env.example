# Скопируйте в .env и при необходимости поменяйте порты.
# На Windows Hyper-V иногда занимает диапазоны портов: если контейнер не стартует с ошибкой
# "ports are not available", посмотрите `netsh interface ipv4 show excludedportrange protocol=tcp`
# и выберите свободный порт. При смене APP_PORT поправьте redirectUris в infra/keycloak/realm-checklist.json.
DB_PORT=5432
KC_PORT=8180
ADMINER_PORT=8181
APP_PORT=8080
