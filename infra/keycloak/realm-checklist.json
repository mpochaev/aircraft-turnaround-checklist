{
  "realm": "checklist",
  "displayName": "Цифровой чек-лист",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["ru"],
  "defaultLocale": "ru",
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "passwordPolicy": "length(8) and digits(1)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "ssoSessionIdleTimeout": 2700,
  "ssoSessionMaxLifespan": 43200,
  "accessTokenLifespan": 300,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT"],
  "eventsListeners": ["jboss-logging"],
  "userProfile": {
    "unmanagedAttributePolicy": "DISABLED",
    "attributes": [
      {
        "name": "username",
        "displayName": "${username}",
        "validations": {
          "length": { "min": 3, "max": 255 },
          "username-prohibited-characters": {},
          "up-username-not-idn-homograph": {}
        },
        "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] },
        "multivalued": false
      },
      {
        "name": "email",
        "displayName": "${email}",
        "validations": { "email": {}, "length": { "max": 255 } },
        "required": { "roles": ["user"] },
        "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] },
        "multivalued": false
      },
      {
        "name": "firstName",
        "displayName": "${firstName}",
        "validations": {
          "length": { "max": 255 },
          "person-name-prohibited-characters": {}
        },
        "required": { "roles": ["user"] },
        "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] },
        "multivalued": false
      },
      {
        "name": "lastName",
        "displayName": "${lastName}",
        "validations": {
          "length": { "max": 255 },
          "person-name-prohibited-characters": {}
        },
        "required": { "roles": ["user"] },
        "permissions": { "view": ["admin", "user"], "edit": ["admin", "user"] },
        "multivalued": false
      },
      {
        "name": "middleName",
        "displayName": "Отчество",
        "validations": {
          "length": { "max": 50 },
          "person-name-prohibited-characters": {}
        },
        "permissions": { "view": ["admin", "user"], "edit": ["admin"] },
        "multivalued": false
      }
    ]
  },
  "roles": {
    "realm": [
      { "name": "technician", "description": "Техник" },
      { "name": "supervisor", "description": "Супервайзер" }
    ]
  },
  "clients": [
    {
      "clientId": "checklist-web",
      "name": "Цифровой чек-лист: страницы",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      }
    },
    {
      "clientId": "checklist-tools",
      "name": "Postman и автотесты API (вход по логину и паролю)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "checklist-log",
      "name": "Сервер: события входа для журнала действий",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "checklist-log-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-checklist-log", "enabled": true, "serviceAccountClientId": "checklist-log",
      "clientRoles": { "realm-management": ["view-events", "view-users"] }
    },
    {
      "username": "sup01", "firstName": "Анна", "lastName": "Петрова", "email": "sup01@checklist.local",
      "attributes": { "middleName": ["Игоревна"] },
      "enabled": true, "emailVerified": true, "realmRoles": ["supervisor"],
      "credentials": [{ "type": "password", "value": "Demo-2026", "temporary": false }]
    },
    {
      "username": "sup02", "firstName": "Олег", "lastName": "Смирнов", "email": "sup02@checklist.local",
      "enabled": true, "emailVerified": true, "realmRoles": ["supervisor"],
      "credentials": [{ "type": "password", "value": "Demo-2026", "temporary": false }]
    },
    {
      "username": "tech07", "firstName": "Пётр", "lastName": "Иванов", "email": "tech07@checklist.local",
      "enabled": true, "emailVerified": true, "realmRoles": ["technician"],
      "credentials": [{ "type": "password", "value": "Demo-2026", "temporary": false }]
    },
    {
      "username": "tech12", "firstName": "Дмитрий", "lastName": "Кузнецов", "email": "tech12@checklist.local",
      "enabled": true, "emailVerified": true, "realmRoles": ["technician"],
      "credentials": [{ "type": "password", "value": "Demo-2026", "temporary": false }]
    }
  ]
}
